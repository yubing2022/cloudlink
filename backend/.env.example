# CloudLink Backend Configuration
# Copy to .env.development (local) or .env.production (deploy)

# ===== Environment =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===== Server =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Database =====
POSTGRES_DB=cloudlink
POSTGRES_USER=cloudlink
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL=postgresql+asyncpg://cloudlink:changeme@postgres:5432/cloudlink

# ===== Redis (future use for WS pub/sub) =====
REDIS_URL=redis://redis:6379/0

# ===== Security =====
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-min-32-bytes-random-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key-here

# ===== CloudLink-specific =====
CLOUDLINK_HEARTBEAT_TIMEOUT_SECONDS=60

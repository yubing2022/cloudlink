<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地 MCP server（只绑 127.0.0.1）需要常驻，走前台服务。
         API 34+ 起前台服务必须声明类型；本地 HTTP 服务不属于既有类型，
         归为 specialUse（不上架 Play，无需担心审核）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".CloudLinkApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudLink"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AgentBridge capability provider (ADR-0114 passive model).
             AgentBridgeClient scans this action on startup and binds the service
             to discover cloudlink.device.* capabilities. Reuses the same login
             session / network stack as the UI above. -->
        <service
            android:name=".capability.CloudLinkCapabilityService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.agentbridge.sdk.ACTION_CAPABILITY_PROVIDER" />
            </intent-filter>
        </service>

        <!-- 本地 MCP server（127.0.0.1:8731/mcp）：给本机 PalmClaw 这类
             端侧 Agent 用标准 HTTP MCP 协议调用设备控制能力。
             不对外暴露：只有本机回环能连上，也没给任何 intent-filter。 -->
        <service
            android:name=".mcp.CloudLinkMcpService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="在本机回环地址 127.0.0.1:8731 提供 MCP server，供同设备的 Agent 应用控制 CloudLink 已接入的智能家居设备" />
        </service>
    </application>
</manifest>
